        <mxCell id="v_legend" value="QUAN HỆ VÀ BỘI SỐ&#10;&#10;R01  User → UserAddress.user&#10;        1 — 0..*&#10;R08  User → Cart.user&#10;        1 — 0..1&#10;R09  Cart → CartItem.cart&#10;        1 — 0..*&#10;R10  Product → CartItem.product&#10;        1 — 0..*&#10;R11  User → Order.user&#10;        1 — 0..*&#10;R12  Order → OrderItem.order&#10;        1 — 0..*&#10;R13  Product → OrderItem.product&#10;        1 — 0..*&#10;R16  Category → Category.parent&#10;        0..1 — 0..*&#10;R17  Category → Product.category&#10;        1 — 0..*&#10;R18  Supplier → Product.supplier&#10;        1 — 0..*&#10;R19  Product → ProductReview.product&#10;        1 — 0..*&#10;R20  User → ProductReview.user&#10;        1 — 0..*" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#17202A;strokeColor=#475569;strokeWidth=1.5;fillColor=#FFFFFF;spacing=8;rounded=0;align=left;verticalAlign=top;fontSize=14;fontColor=#17202A;" vertex="1" parent="1">
