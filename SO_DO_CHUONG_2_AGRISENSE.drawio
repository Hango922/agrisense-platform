        <mxCell id="v_note11" value="Mỗi liên kết đọc theo chiều từ bảng cha đến bảng con: số đầu = số cha của một con; số sau = số con của một cha. Thuộc tính đầy đủ xem từ điển dữ liệu." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fontColor=#17202A;strokeColor=#475569;strokeWidth=1.5;fillColor=#FFFFFF;spacing=8;strokeColor=none;fillColor=none;fontSize=14;fontColor=#17202A;fontColor=#17202A;" vertex="1" parent="1">
