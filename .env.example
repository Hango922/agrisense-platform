# File: .env.example
# Generate a local key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=nongsan_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

AI_PROVIDER=gemini
# Empty keys enable the offline rule-based fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

CHATBOT_TIMEOUT=10
GEMINI_MODEL=gemini-2.5-flash
PLANNER_GEMINI_MODEL=gemini-3.1-flash-lite
PLANNER_AI_TIMEOUT=30
GROQ_MODEL=llama-3.1-8b-instant

# Replace these placeholders before accepting real transfers.
VIETQR_BANK_ID=TCB
VIETQR_ACCOUNT_NO=your-bank-account-number
VIETQR_ACCOUNT_NAME=YOUR ACCOUNT NAME
VIETQR_BANK_NAME=Techcombank

# For phone scans, use the server's LAN URL and add its IP to ALLOWED_HOSTS.
QR_BASE_URL=http://127.0.0.1:8000
# Optional signed payment-adapter webhook; leave empty to disable.
# Generate a random secret of at least 32 characters before integration.
PAYMENT_WEBHOOK_SECRET=
